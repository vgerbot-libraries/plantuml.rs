# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# PlantUML reference repo (read-only clone, not part of this project)
temp/

# Generated WASM packages and TypeScript build output
bindings/plantuml-ts/wasm/
bindings/plantuml-ts/dist/
bindings/plantuml-ts/node_modules/
crates/plantuml-wasm/pkg-*/

# Gradle build artifacts
bindings/plantuml-java/.gradle/
bindings/plantuml-java/build/
bindings/plantuml-java/bin/

# Root node_modules (dev tooling only)
node_modules/

# Vendored test-only PlantUML jar (not committed; developers copy locally)
crates/plantuml-engine/tests/vendor/

# Vega test expected-output files are generated at runtime by the Java JAR.
# Only .puml input files are committed. See .agents/rules/test-parity.md.
crates/plantuml-engine/tests/resources/vega/**/*.svg
crates/plantuml-engine/tests/resources/vega/**/*.txt
crates/plantuml-engine/tests/resources/vega/**/*.utxt
crates/plantuml-engine/tests/resources/vega/**/*.atxt
crates/plantuml-engine/tests/resources/vega/**/*.preproc
crates/plantuml-engine/tests/resources/vega/**/*.xmi
crates/plantuml-engine/tests/resources/vega/**/*.tex
crates/plantuml-engine/tests/resources/vega/**/*.scxml
crates/plantuml-engine/tests/resources/vega/**/*.graphml
# Debug output from failed tests
crates/plantuml-engine/tests/resources/vega/**/*.actual.svg
